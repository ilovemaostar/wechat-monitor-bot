:root {
  font-family: Inter, system-ui, sans-serif;
  color: #e5eefc;
  background: #0d1523;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: linear-gradient(180deg, #0d1523, #101a2c);
}

button,
textarea {
  font: inherit;
}

.dashboard {
  max-width: 1280px;
  margin: 0 auto;
  padding: 32px 20px 60px;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30px;
}

.eyebrow {
  margin: 0;
  color: #6ea8fe;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  font-size: 12px;
}

h1, h2, p {
  margin-top: 0;
}

button {
  background: #0ea5e9;
  color: white;
  border: none;
  border-radius: 10px;
  padding: 10px 18px;
  cursor: pointer;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(180px, 1fr));
  gap: 20px;
  margin-bottom: 24px;
}

.card,
.panel {
  background: rgba(15, 23, 42, 0.85);
  border: 1px solid rgba(148, 163, 184, 0.2);
  border-radius: 14px;
  padding: 18px;
  box-shadow: 0 10px 30px rgba(15, 23, 42, 0.25);
}

.card span {
  display: block;
  color: #a4b5d5;
  margin-bottom: 10px;
}

.card strong {
  font-size: 28px;
}

.panel-grid {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: 20px;
  margin-bottom: 24px;
}

textarea {
  width: 100%;
  min-height: 120px;
  border-radius: 10px;
  border: 1px solid rgba(148, 163, 184, 0.3);
  background: rgba(15, 23, 42, 0.7);
  color: #eff6ff;
  padding: 12px;
  margin: 14px 0;
  resize: vertical;
}

.reply-box {
  margin-top: 14px;
  background: rgba(14, 165, 233, 0.1);
  border-left: 4px solid #38bdf8;
  border-radius: 8px;
  padding: 12px;
  color: #dbeafe;
}

.rule-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  gap: 12px;
}

.rule-list li {
  background: rgba(30, 41, 59, 0.7);
  border-radius: 10px;
  padding: 12px;
}

.rule-list div {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 8px;
}

.rule-list span {
  color: #7dd3fc;
}

table {
  width: 100%;
  border-collapse: collapse;
  margin-top: 12px;
}

th, td {
  text-align: left;
  border-bottom: 1px solid rgba(148, 163, 184, 0.2);
  padding: 10px 8px;
  vertical-align: top;
}

@media (max-width: 800px) {
  .summary-grid,
  .panel-grid {
    grid-template-columns: 1fr;
  }

  .header {
    display: block;
  }
}
